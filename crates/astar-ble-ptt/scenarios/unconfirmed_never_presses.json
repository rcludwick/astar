{
  "name": "unconfirmed_never_presses",
  "device": "inrico-b02ptt",
  "steps": [
    { "at_ms": 0,    "event": {"kind": "enable", "confirmed": false},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 1,    "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 10,   "event": {"kind": "connected", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 20,   "event": {"kind": "gatt_accepted", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 30,   "event": {"kind": "subscribed", "epoch": 1},
      "expect": {"intent": "none", "status": "needs_confirm", "cmds": []} },
    { "at_ms": 2000, "event": {"kind": "notify", "epoch": 1, "bytes": [1]},
      "expect": {"intent": "none", "status": "needs_confirm", "cmds": [], "pressed": false, "raw_pressed": true} },
    { "at_ms": 2400, "event": {"kind": "notify", "epoch": 1, "bytes": [0]},
      "expect": {"intent": "release", "reason": "button", "status": "needs_confirm", "cmds": [], "pressed": false, "raw_pressed": false} },
    { "at_ms": 3000, "event": {"kind": "notify", "epoch": 1, "bytes": [1]},
      "expect": {"intent": "none", "status": "needs_confirm", "cmds": [], "pressed": false, "raw_pressed": true} }
  ]
}
