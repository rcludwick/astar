{
  "name": "idle_disconnect_first_press_keys",
  "device": "inrico-b02ptt",
  "steps": [
    { "at_ms": 0,    "event": {"kind": "enable", "confirmed": true},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 1,    "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 10,   "event": {"kind": "connected", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 20,   "event": {"kind": "gatt_accepted", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 30,   "event": {"kind": "subscribed", "epoch": 1},
      "expect": {"intent": "none", "status": "ready", "cmds": []} },
    { "at_ms": 500,  "event": {"kind": "disconnected", "epoch": 1},
      "expect": {"intent": "none", "status": "reconnecting", "cmds": [], "pressed": false, "raw_pressed": false} },
    { "at_ms": 600,  "event": {"kind": "connected", "epoch": 2},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 610,  "event": {"kind": "gatt_accepted", "epoch": 2},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 620,  "event": {"kind": "subscribed", "epoch": 2},
      "expect": {"intent": "none", "status": "ready", "cmds": []} },
    { "at_ms": 920,  "event": {"kind": "notify", "epoch": 2, "bytes": [1]},
      "expect": {"intent": "press", "status": "ready", "cmds": [], "pressed": true, "raw_pressed": true} },
    { "at_ms": 1200, "event": {"kind": "notify", "epoch": 2, "bytes": [0]},
      "expect": {"intent": "release", "reason": "button", "status": "ready", "cmds": [], "pressed": false, "raw_pressed": false} },
    { "at_ms": 1300, "event": {"kind": "sleep"},
      "expect": {"intent": "none", "status": "reconnecting", "cmds": [], "pressed": false, "raw_pressed": false} },
    { "at_ms": 1310, "event": {"kind": "wake"},
      "expect": {"intent": "none", "status": "reconnecting", "cmds": [], "pressed": false} },
    { "at_ms": 1400, "event": {"kind": "connected", "epoch": 3},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 1410, "event": {"kind": "gatt_accepted", "epoch": 3},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 1420, "event": {"kind": "subscribed", "epoch": 3},
      "expect": {"intent": "none", "status": "ready", "cmds": []} },
    { "at_ms": 1720, "event": {"kind": "notify", "epoch": 3, "bytes": [1]},
      "expect": {"intent": "press", "status": "ready", "cmds": [], "pressed": true, "raw_pressed": true} },
    { "at_ms": 1800, "event": {"kind": "notify", "epoch": 3, "bytes": [0]},
      "expect": {"intent": "release", "reason": "button", "status": "ready", "cmds": [], "pressed": false, "raw_pressed": false} }
  ]
}
