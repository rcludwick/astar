{
  "name": "rssi_reply_resets_misses",
  "device": "inrico-b02ptt",
  "steps": [
    { "at_ms": 0,    "event": {"kind": "enable", "confirmed": true},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 1,    "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 10,   "event": {"kind": "connected", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 20,   "event": {"kind": "gatt_accepted", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 30,   "event": {"kind": "subscribed", "epoch": 1},
      "expect": {"intent": "none", "status": "ready", "cmds": []} },
    { "at_ms": 1000, "event": {"kind": "notify", "epoch": 1, "bytes": [1]},
      "expect": {"intent": "press", "status": "ready", "cmds": [], "pressed": true, "raw_pressed": true} },
    { "at_ms": 1500, "event": {"kind": "tick"},
      "expect": {"intent": "none", "status": "ready", "cmds": ["probe"], "pressed": true} },
    { "at_ms": 2000, "event": {"kind": "tick"},
      "expect": {"intent": "none", "status": "ready", "cmds": ["probe"], "pressed": true} },
    { "at_ms": 2100, "event": {"kind": "probe_ok", "epoch": 1, "rssi": -60},
      "expect": {"intent": "none", "status": "ready", "cmds": [], "pressed": true, "signal": "strong"} },
    { "at_ms": 2500, "event": {"kind": "tick"},
      "expect": {"intent": "none", "status": "ready", "cmds": ["probe"], "pressed": true} },
    { "at_ms": 3000, "event": {"kind": "tick"},
      "expect": {"intent": "none", "status": "ready", "cmds": ["probe"], "pressed": true} },
    { "at_ms": 3100, "event": {"kind": "probe_ok", "epoch": 1, "rssi": -70},
      "expect": {"intent": "none", "status": "ready", "cmds": [], "pressed": true, "signal": "fair"} },
    { "at_ms": 3500, "event": {"kind": "tick"},
      "expect": {"intent": "none", "status": "ready", "cmds": ["probe"], "pressed": true} }
  ]
}
