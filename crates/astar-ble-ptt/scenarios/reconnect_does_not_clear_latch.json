{
  "name": "reconnect_does_not_clear_latch",
  "device": "inrico-b02ptt",
  "steps": [
    { "at_ms": 0,    "event": {"kind": "enable", "confirmed": true},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 1,    "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 10,   "event": {"kind": "connected", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 20,   "event": {"kind": "gatt_accepted", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 30,   "event": {"kind": "subscribed", "epoch": 1},
      "expect": {"intent": "none", "status": "ready", "cmds": []} },
    { "at_ms": 2000, "event": {"kind": "notify", "epoch": 1, "bytes": [1]},
      "expect": {"intent": "press", "status": "ready", "cmds": [], "pressed": true, "raw_pressed": true} },
    { "at_ms": 2100, "event": {"kind": "adapter", "state": "off"},
      "expect": {"intent": "release", "reason": "adapter_off", "status": "bluetooth_off", "cmds": [], "pressed": false} },
    { "at_ms": 2200, "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "reconnecting", "cmds": []} },
    { "at_ms": 2300, "event": {"kind": "connected", "epoch": 2},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 2310, "event": {"kind": "gatt_accepted", "epoch": 2},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 2320, "event": {"kind": "subscribed", "epoch": 2},
      "expect": {"intent": "none", "status": "release_to_arm", "cmds": []} },
    { "at_ms": 2400, "event": {"kind": "disconnected", "epoch": 2},
      "expect": {"intent": "none", "status": "reconnecting", "cmds": [], "pressed": false} },
    { "at_ms": 2500, "event": {"kind": "connected", "epoch": 3},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 2510, "event": {"kind": "gatt_accepted", "epoch": 3},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 2520, "event": {"kind": "subscribed", "epoch": 3},
      "expect": {"intent": "none", "status": "release_to_arm", "cmds": []} },
    { "at_ms": 3000, "event": {"kind": "notify", "epoch": 3, "bytes": [1]},
      "expect": {"intent": "none", "status": "release_to_arm", "cmds": [], "pressed": false, "raw_pressed": true} }
  ]
}
