{
  "name": "gatt_rejected_lookalike",
  "device": "inrico-b02ptt",
  "steps": [
    { "at_ms": 0,   "event": {"kind": "enable", "confirmed": true},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 1,   "event": {"kind": "adapter", "state": "on"},
      "expect": {"intent": "none", "status": "searching", "cmds": []} },
    { "at_ms": 10,  "event": {"kind": "connected", "epoch": 1},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} },
    { "at_ms": 20,  "event": {"kind": "gatt_rejected", "epoch": 1},
      "expect": {"intent": "none", "status": "not_supported_device", "cmds": ["drop_link"]} },
    { "at_ms": 30,  "event": {"kind": "subscribed", "epoch": 1},
      "expect": {"intent": "none", "status": "not_supported_device", "cmds": []} },
    { "at_ms": 40,  "event": {"kind": "notify", "epoch": 1, "bytes": [1]},
      "expect": {"intent": "none", "status": "not_supported_device", "cmds": [], "pressed": false, "raw_pressed": false} },
    { "at_ms": 50,  "event": {"kind": "disconnected", "epoch": 1},
      "expect": {"intent": "none", "status": "not_supported_device", "cmds": []} },
    { "at_ms": 100, "event": {"kind": "connected", "epoch": 2},
      "expect": {"intent": "none", "status": "connecting", "cmds": []} }
  ]
}
