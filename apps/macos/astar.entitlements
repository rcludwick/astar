<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The engine captures the microphone (IAX2/M17/D-Star transmit). Under the
	     hardened runtime, which notarization requires, mic access is refused
	     without this entitlement — the app would launch and then fail to open an
	     input device. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
