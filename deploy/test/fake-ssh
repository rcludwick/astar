# fake-ssh — ASTAR_SSH stand-in for deploy/test/test_verify.sh. Ignores the
# host and runs the remote command locally, with fakebox/ first on PATH so
# podman, df, ss, curl and id answer canned output. stdin passes through, so
# the fact-collector script verify.sh pipes in runs for real.
set -u
[ -n "${FAKE_SSH_FAIL:-}" ] && { echo "ssh: connect to host: Connection refused" >&2; exit 255; }
while [ $# -gt 1 ]; do shift; done   # drop options and the host
PATH="$(cd "$(dirname "$0")" && pwd)/fakebox:$PATH" exec bash -c "$1"
