# Runtime base for astar-server (iax-4703). Ships rarely — only when OS
# deps, piper, or the voice change. Built --platform linux/amd64.
FROM docker.io/library/debian:13-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libasound2t64 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

ARG PIPER_URL=https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz
ARG PIPER_SHA256=a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992
ARG VOICE_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_GB/cori/medium
ARG VOICE_SHA256=1899f98e5fb8310154f3c2973f4b8a929ba7245e722b3d3a85680b833d95f10d
ARG VOICE_JSON_SHA256=e262c16d7f192f69d4edd6b4ef8a5915379e67495fcc402f1ab15eeb33da3d36

# piper release tarball extracts to /opt/piper (binary + bundled .so libs +
# espeak-ng-data); $ORIGIN rpath resolves through the /usr/local/bin symlink.
RUN set -eux; \
    curl -fsSL -o /tmp/piper.tar.gz "$PIPER_URL"; \
    echo "$PIPER_SHA256  /tmp/piper.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/piper.tar.gz -C /opt; \
    ln -s /opt/piper/piper /usr/local/bin/piper; \
    rm /tmp/piper.tar.gz; \
    mkdir -p /usr/share/piper/voices; \
    curl -fsSL -o /usr/share/piper/voices/en_GB-cori-medium.onnx \
        "$VOICE_BASE/en_GB-cori-medium.onnx"; \
    echo "$VOICE_SHA256  /usr/share/piper/voices/en_GB-cori-medium.onnx" | sha256sum -c -; \
    curl -fsSL -o /usr/share/piper/voices/en_GB-cori-medium.onnx.json \
        "$VOICE_BASE/en_GB-cori-medium.onnx.json"; \
    echo "$VOICE_JSON_SHA256  /usr/share/piper/voices/en_GB-cori-medium.onnx.json" | sha256sum -c -

RUN useradd --uid 1000 --create-home iaxnode
USER iaxnode
