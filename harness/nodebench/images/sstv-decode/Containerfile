# nodebench: an outside SSTV decoder, sharing no code with astar.
#
# Two Python decoders, each pinned to a commit and run unmodified:
#   colaclanth/sstv (GPLv3)     Martin 1/2, Scottie 1/2/DX, Robot 36/72
#   ta2ldv/sstv-decoder         Martin, Scottie and PD50/90/120 (no licence
#                               file; fetched at build time, never committed)
# decode.sh tries the first and falls back to the second. RIG.md ("SSTV: the
# outside decoder") records which decoder serves which mode. The network is
# needed once, to build; the bench runs the image with `--network none`.
#
# The Python packages the decoders need directly are pinned to the versions
# the image was built and measured with (2026-11-19). Their own dependencies
# (contourpy, fonttools and the like) and the python:3.12-slim base still
# float to whatever is current at build time.
#
#   podman build -t localhost/nodebench-sstv-decode harness/nodebench/images/sstv-decode
FROM docker.io/library/python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libsndfile1 \
 && rm -rf /var/lib/apt/lists/*

ARG SSTV_COMMIT=3e556eee8ad4c4425799cb652bac26ee58f8e113
ARG PD_COMMIT=28a44e4d0b7f70c193d712a2c23ccb629ab68f8f
RUN set -eux; \
    pip install --no-cache-dir numpy==2.5.5 scipy==1.18.1 Pillow==13.0.0 \
        soundfile==0.14.0 PySoundFile==0.9.0.post1 matplotlib==3.11.2 \
        "https://github.com/colaclanth/sstv/archive/${SSTV_COMMIT}.tar.gz"; \
    python -c "import urllib.request as u; open('/usr/local/lib/sstv_decoder.py','wb').write(u.urlopen('https://raw.githubusercontent.com/ta2ldv/sstv-decoder/${PD_COMMIT}/sstv_decoder.py').read())"

COPY decode.sh /usr/local/bin/decode
RUN chmod +x /usr/local/bin/decode
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/decode"]
