# Basic in-order voice stream, steady 20 ms delay, no jitter.
# Verifies the simplest happy-path: put/get pairs with no growth.
config 0 1000 0 40
put 20 0 20 voice 00
put 40 20 20 voice 01
put 60 40 20 voice 02
put 80 60 20 voice 03
put 100 80 20 voice 04
next 0
get 0 20
get 20 20
get 40 20
get 60 20
get 80 20
get 100 20
get 120 20
